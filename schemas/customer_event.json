{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CustomerEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique identifier for this event"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer identifier (e.g. C1029)"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "page_view",
        "product_view",
        "search",
        "add_to_cart",
        "remove_from_cart",
        "checkout_started",
        "checkout_abandoned",
        "session_started",
        "session_ended"
      ]
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "session_id": {
      "type": "string",
      "description": "User session token"
    },
    "source": {
      "type": "string",
      "default": "web-storefront"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "page_url": { "type": "string" },
        "product_id": { "type": "string" },
        "product_name": { "type": "string" },
        "cart_value": { "type": "number" },
        "device": { "type": "string" }
      }
    }
  },
  "required": ["event_id", "customer_id", "event_type", "event_time"]
}
