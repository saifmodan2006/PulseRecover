# ==============================================================================
# PULSERECOVER AI - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Set APP_MODE to 'demo', 'development', or 'production'
# In 'demo' or 'development' mode, if Confluent credentials are not provided,
# the platform seamlessly falls back to the in-process local streaming engine.
APP_MODE=demo
ENVIRONMENT=pulse-recover-prod

# ==============================================================================
# CONFLUENT CLOUD - KAFKA SETTINGS
# ==============================================================================
CONFLUENT_BOOTSTRAP_SERVER=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
CONFLUENT_KAFKA_API_KEY=YOUR_CONFLUENT_KAFKA_API_KEY
CONFLUENT_KAFKA_API_SECRET=YOUR_CONFLUENT_KAFKA_API_SECRET

# ==============================================================================
# CONFLUENT CLOUD - SCHEMA REGISTRY
# ==============================================================================
CONFLUENT_SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-1.aws.confluent.cloud
CONFLUENT_SCHEMA_REGISTRY_API_KEY=YOUR_SCHEMA_REGISTRY_KEY
CONFLUENT_SCHEMA_REGISTRY_API_SECRET=YOUR_SCHEMA_REGISTRY_SECRET

# ==============================================================================
# CONFLUENT CLOUD - FLINK SETTINGS
# ==============================================================================
CONFLUENT_FLINK_API_KEY=YOUR_FLINK_API_KEY
CONFLUENT_FLINK_API_SECRET=YOUR_FLINK_API_SECRET
CONFLUENT_FLINK_COMPUTE_POOL_ID=cp-xxxxx

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection string. Defaults to SQLite for local development if not set.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulsercover_db
DATABASE_URL=sqlite:///./pulsercover.db

# ==============================================================================
# SERVICE INTEGRATIONS & APIS
# ==============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
RECOVERY_API_URL=http://localhost:8000/api/recovery-actions
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional LLM / AI key (only if remote inference is enabled)
# OPENAI_API_KEY=
